# Copie para .env.local e preencha. Nunca faça commit de valores reais.
# URL do backend. Vazia = modo de exemplo (mocks, sem rede).
VITE_API_URL=
# Enviada como cabeçalho X-API-Key em toda chamada a /api/... (igual à API_KEY do backend).
# Vazia = nenhum cabeçalho é enviado. ATENÇÃO: fica visível no bundle do navegador.
VITE_API_KEY=
